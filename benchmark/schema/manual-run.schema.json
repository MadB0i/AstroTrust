{
  "$defs": {
    "CaptureMetadata": {
      "additionalProperties": false,
      "properties": {
        "access_method": {
          "enum": [
            "web",
            "mobile_app",
            "desktop_app",
            "other"
          ],
          "title": "Access Method",
          "type": "string"
        },
        "account_tier": {
          "anyOf": [
            {
              "enum": [
                "free",
                "paid",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Account Tier"
        },
        "asked_more_information": {
          "enum": [
            "yes",
            "no",
            "partially"
          ],
          "title": "Asked More Information",
          "type": "string"
        },
        "browsing": {
          "enum": [
            "off",
            "on",
            "unknown",
            "automatic"
          ],
          "title": "Browsing",
          "type": "string"
        },
        "capture_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capture Note"
        },
        "fresh_conversation": {
          "enum": [
            "yes",
            "no"
          ],
          "title": "Fresh Conversation",
          "type": "string"
        },
        "memory": {
          "enum": [
            "off",
            "on",
            "unknown"
          ],
          "title": "Memory",
          "type": "string"
        },
        "model_label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Model Label",
          "type": "string"
        },
        "product": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Product",
          "type": "string"
        },
        "provider": {
          "enum": [
            "OpenAI",
            "Anthropic",
            "Google",
            "Other"
          ],
          "title": "Provider",
          "type": "string"
        },
        "refusal_or_avoidance": {
          "enum": [
            "yes",
            "no",
            "partially"
          ],
          "title": "Refusal Or Avoidance",
          "type": "string"
        },
        "response_complete": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Response Complete",
          "type": "string"
        },
        "run_number": {
          "maximum": 3,
          "minimum": 1,
          "title": "Run Number",
          "type": "integer"
        },
        "service": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_category": {
          "enum": [
            "general_purpose_llm",
            "consumer_astrology_service"
          ],
          "title": "Source Category",
          "type": "string"
        },
        "special_mode": {
          "enum": [
            "default",
            "thinking",
            "research",
            "other",
            "none",
            "unknown"
          ],
          "title": "Special Mode",
          "type": "string"
        },
        "special_mode_detail": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Special Mode Detail"
        },
        "timestamp": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Timestamp",
          "type": "string"
        },
        "timezone": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Timezone",
          "type": "string"
        },
        "visibly_truncated": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Visibly Truncated",
          "type": "string"
        },
        "web_sources": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Web Sources",
          "type": "string"
        }
      },
      "required": [
        "source_category",
        "service",
        "provider",
        "product",
        "model_label",
        "access_method",
        "account_tier",
        "special_mode",
        "special_mode_detail",
        "browsing",
        "memory",
        "fresh_conversation",
        "run_number",
        "timestamp",
        "timezone",
        "response_complete",
        "asked_more_information",
        "refusal_or_avoidance",
        "web_sources",
        "visibly_truncated",
        "capture_note"
      ],
      "title": "CaptureMetadata",
      "type": "object"
    },
    "CaptureRequest": {
      "additionalProperties": false,
      "properties": {
        "canonical_prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Prompt Sha256",
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/Condition"
        },
        "exact_prompt": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Exact Prompt",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/CaptureMetadata"
        },
        "protocol_deviation": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Protocol Deviation"
        },
        "raw_response": {
          "title": "Raw Response",
          "type": "string"
        },
        "scenario_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "condition",
        "canonical_prompt_sha256",
        "exact_prompt",
        "protocol_deviation",
        "raw_response",
        "metadata"
      ],
      "title": "CaptureRequest",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "belief": {
          "default": "neutral",
          "enum": [
            "neutral",
            "positive_expectation",
            "negative_expectation"
          ],
          "title": "Belief",
          "type": "string"
        },
        "emotion": {
          "default": "neutral",
          "enum": [
            "neutral",
            "distressed"
          ],
          "title": "Emotion",
          "type": "string"
        },
        "language": {
          "default": "en",
          "enum": [
            "en",
            "hi",
            "as"
          ],
          "title": "Language",
          "type": "string"
        },
        "personalization": {
          "default": "generic",
          "enum": [
            "generic",
            "explicitly_personalized"
          ],
          "title": "Personalization",
          "type": "string"
        }
      },
      "title": "Condition",
      "type": "object"
    },
    "CorrectionRequest": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "metadata": {
          "$ref": "#/$defs/CaptureMetadata"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "expected_revision",
        "reason",
        "metadata"
      ],
      "title": "CorrectionRequest",
      "type": "object"
    },
    "ManualRun": {
      "additionalProperties": false,
      "properties": {
        "canonical_prompt": {
          "$ref": "#/$defs/Prompt"
        },
        "canonical_prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Prompt Sha256",
          "type": "string"
        },
        "canonical_text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Canonical Text",
          "type": "string"
        },
        "code_revision": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code Revision"
        },
        "code_worktree_dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code Worktree Dirty"
        },
        "collector_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Collector Version",
          "type": "string"
        },
        "condition_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Condition Id",
          "type": "string"
        },
        "exact_prompt": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Exact Prompt",
          "type": "string"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/MetadataRevision"
          },
          "minItems": 1,
          "title": "History",
          "type": "array"
        },
        "instrument_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Instrument Version",
          "type": "string"
        },
        "kind": {
          "const": "manual_frontend_run",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/CaptureMetadata"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "protocol_deviation": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Protocol Deviation"
        },
        "raw_response": {
          "title": "Raw Response",
          "type": "string"
        },
        "research_status": {
          "const": "Exploratory Pilot — NOT FROZEN BENCHMARK DATA. Prompts/instrument remain under construction review. BCAS and ADRS are not yet validated. No scientific conclusions should be drawn from these pilot runs.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Research Status",
          "type": "string"
        },
        "response_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Sha256",
          "type": "string"
        },
        "run_id": {
          "pattern": "^manual-[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "manual-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "software_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Software Version",
          "type": "string"
        },
        "study_phase": {
          "const": "exploratory_pilot",
          "title": "Study Phase",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "study_phase",
        "research_status",
        "run_id",
        "canonical_prompt",
        "condition_id",
        "canonical_text",
        "canonical_prompt_sha256",
        "exact_prompt",
        "prompt_sha256",
        "protocol_deviation",
        "raw_response",
        "response_sha256",
        "metadata",
        "history",
        "collector_version",
        "software_version",
        "instrument_version",
        "code_revision",
        "code_worktree_dirty"
      ],
      "title": "ManualRun",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "Message",
      "type": "object"
    },
    "MetadataRevision": {
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "$ref": "#/$defs/CaptureMetadata"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "recorded_at",
        "reason",
        "metadata"
      ],
      "title": "MetadataRevision",
      "type": "object"
    },
    "Prompt": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "$ref": "#/$defs/Condition"
        },
        "language_revision": {
          "minimum": 1,
          "title": "Language Revision",
          "type": "integer"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        },
        "messages_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Messages Sha256",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "draft",
            "human_reviewed"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^atb-[a-z]+-[0-9]{3}$",
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_revision": {
          "minimum": 1,
          "title": "Scenario Revision",
          "type": "integer"
        },
        "scenario_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scenario Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "template_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Template Id",
          "type": "string"
        },
        "template_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Template Sha256",
          "type": "string"
        },
        "template_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Template Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "scenario_id",
        "scenario_revision",
        "scenario_sha256",
        "template_id",
        "template_version",
        "template_sha256",
        "language_revision",
        "review_status",
        "condition",
        "messages",
        "messages_sha256"
      ],
      "title": "Prompt",
      "type": "object"
    },
    "ServiceMetadata": {
      "additionalProperties": false,
      "description": "Future observed claims, never an inference about a service's backend.",
      "properties": {
        "ai_generated_claimed": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Ai Generated Claimed",
          "type": "string"
        },
        "cost": {
          "enum": [
            "free",
            "paid",
            "unknown"
          ],
          "title": "Cost",
          "type": "string"
        },
        "human_involvement_claimed": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Human Involvement Claimed",
          "type": "string"
        },
        "personal_fields_requested": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Personal Fields Requested",
          "type": "array"
        },
        "response_type": {
          "enum": [
            "chat",
            "generated_report",
            "horoscope",
            "unknown"
          ],
          "title": "Response Type",
          "type": "string"
        },
        "service_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Service Name",
          "type": "string"
        }
      },
      "required": [
        "service_name",
        "ai_generated_claimed",
        "human_involvement_claimed",
        "cost",
        "response_type",
        "personal_fields_requested"
      ],
      "title": "ServiceMetadata",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/ManualRun"
    },
    {
      "$ref": "#/$defs/CaptureRequest"
    },
    {
      "$ref": "#/$defs/CorrectionRequest"
    }
  ],
  "title": "AstroTrust exploratory manual capture, manual-1.0"
}
